# ============================================================
# 一键上岸 环境变量配置
# 复制此文件为 .env 并填入实际值
# 生产环境（Render）请在 Dashboard 中设置这些环境变量
# ============================================================

# JWT 密钥（生产环境必须更换为强随机字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=yijianshangan-jwt-secret-change-in-production

# 应用公开 URL（用于支付回调跳转）
# 生产环境改为你的 Render 域名
APP_URL=http://localhost:3456

# ============================================================
# LemonSqueezy 支付配置（可选，不配置则使用模拟支付）
# 注册地址：https://www.lemonsqueezy.com
# ============================================================

# Store ID（在 LemonSqueezy Settings > Stores 中找到）
LEMONSQUEEZY_STORE_ID=

# API Key（在 LemonSqueezy Settings > API 中创建）
LEMONSQUEEZY_API_KEY=

# Webhook Signing Secret（在 LemonSqueezy Settings > Webhooks 中获取）
LEMONSQUEEZY_SIGNING_SECRET=

# 各套餐对应的 Variant ID（在 LemonSqueezy Products 中创建产品后获取）
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_PREMIUM=
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_YEARLY=

# ============================================================
# 其他可选配置
# ============================================================

# 服务端口（默认 3456）
PORT=3456

# 数据目录
DATA_DIR=.

# 跳过网关（云端部署设 1）
NO_GATEWAY=1
